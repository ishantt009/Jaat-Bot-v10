# Discord Bot Configuration for Hosting
# ===========================================

# Required: Discord Bot Token (IMPORTANT: Your bot expects DISCORD_BOT_TOKEN, not DISCORD_TOKEN)
DISCORD_BOT_TOKEN=your_bot_token_here

# Bot Settings
# ===========================================
COMMAND_PREFIX=!

# Permission Role Names
# ===========================================
ADMIN_ROLE_NAME=Admin
MODERATOR_ROLE_NAME=Moderator

# Rate Limiting Settings
# ===========================================
MASS_DM_RATE_LIMIT=1.0

# Logging Configuration
# ===========================================
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE_PATH=logs/bot.log

# Production Settings
# ===========================================
DEBUG_MODE=false
DEV_GUILD_ID=

# Feature Toggles
# ===========================================
ENABLE_AUTO_SYNC=true
ENABLE_SLASH_COMMANDS=true
STRICT_PERMISSIONS=true

# Bot Activity Settings
# ===========================================
BOT_ACTIVITY_TYPE=watching
BOT_ACTIVITY_NAME={prefix}help | /help

# Hosting Platform Specific
# ===========================================
PORT=5000
PYTHONPATH=.